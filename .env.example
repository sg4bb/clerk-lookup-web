# Copia este archivo como .env.local y completa los dos valores.
# Están en Supabase > Project Settings > API.
#
# Usa SOLO la clave pública (anon / publishable). La clave service_role
# es del worker y nunca va aquí: todo lo que empieza con NEXT_PUBLIC_
# termina dentro del navegador del usuario.
#
# Si faltan, el login avisa que el sitio no está configurado y no deja entrar.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

